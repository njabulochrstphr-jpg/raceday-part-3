@{var items=ViewBag.Items as List<RaceDay.Mvc.Controllers.JsonEnrolment> ?? new();}<h1>My enrolments</h1><div class="table-responsive"><table class="table"><thead><tr><th>Event</th><th>Category</th><th>Date enrolled</th><th>Status</th></tr></thead><tbody>@foreach(var e in items){<tr><td>@e.EventTitle</td><td>@e.Category</td><td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td><td><span class="status">@e.Status</span></td></tr>}</tbody></table></div>
