@{var events=ViewBag.Events as List<RaceDay.Mvc.Models.EventVm> ?? new();}<div class="d-flex justify-content-between align-items-center"><div><p class="eyebrow">ORGANISER SPACE</p><h1>Dashboard</h1><p class="muted">Welcome, @ViewBag.Name</p></div><a class="btn btn-warning" href="/Organiser/Create">+ Create event</a></div><div class="stat"><strong>@events.Count</strong><span>Events listed by the API</span></div><h3 class="mt-5">Your event overview</h3><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Event</th><th>Date</th><th>Location</th><th>Type</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var e in events){<tr><td>@e.Title</td><td>@e.EventDate.ToString("dd MMM yyyy")</td><td>@e.Location</td><td>@e.EventType</td><td><span class="status">@e.Status</span></td><td><a href="/Organiser/Delete/@e.Id" onclick="return confirm('Delete this event?')">Delete</a></td></tr>}</tbody></table></div>
