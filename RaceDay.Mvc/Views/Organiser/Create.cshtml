@model EventVm
<h1>Create an event</h1><p class="muted">Add the details participants need to know.</p>@if(ViewBag.Error!=null){<div class="alert alert-danger">@ViewBag.Error</div>}<form method="post" class="form-card"><label>Event name</label><input asp-for="Title" class="form-control" required/><label class="mt-3">Description</label><textarea asp-for="Description" class="form-control"></textarea><label class="mt-3">Date and time</label><input asp-for="EventDate" type="datetime-local" class="form-control" required/><label class="mt-3">Location</label><input asp-for="Location" class="form-control" required/><label class="mt-3">Distance (km)</label><input asp-for="Distance" type="number" step="0.1" min="0" class="form-control" required/><label class="mt-3">Event type</label><select asp-for="EventType" class="form-select"><option>Run</option><option>Walk</option><option>Cycle</option></select><button class="btn btn-warning mt-4">Save event</button></form>
