@model RegisterVm
<h1>Create account</h1><p class="muted">Join the RaceDay community.</p>@if(ViewBag.Error!=null){<div class="alert alert-danger">@ViewBag.Error</div>}<form method="post" class="form-card"><label>Name</label><input asp-for="Name" class="form-control" required/><label class="mt-3">Email</label><input asp-for="Email" type="email" class="form-control" required/><label class="mt-3">Password</label><input asp-for="Password" type="password" class="form-control" minlength="6" required/><label class="mt-3">Account type</label><select asp-for="Role" class="form-select"><option>Participant</option><option>Organiser</option></select><button class="btn btn-warning mt-4">Create account</button></form>
