@{var items=ViewBag.Items as List<RaceDay.Mvc.Controllers.JsonResult> ?? new();}<h1>My results</h1><p class="muted">Your completed event history.</p><div class="table-responsive"><table class="table"><thead><tr><th>Event</th><th>Category</th><th>Finish time</th><th>Position</th></tr></thead><tbody>@foreach(var e in items){<tr><td>@e.EventTitle</td><td>@e.Category</td><td>@e.FinishTime</td><td>#@e.Position</td></tr>}</tbody></table></div>
