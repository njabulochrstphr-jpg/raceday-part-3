<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>RaceDay</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link rel="stylesheet" href="~/css/site.css"/></head><body><nav class="navbar navbar-expand-lg navbar-dark"><div class="container"><a class="navbar-brand fw-bold" href="/">RACEDAY<span>.</span></a><div class="navbar-nav ms-auto">@if(Context.Session.GetString("Role")=="Organiser"){<a class="nav-link" href="/Organiser">Dashboard</a>}else if(Context.Session.GetString("Role")=="Participant"){<a class="nav-link" href="/Participant">Events</a><a class="nav-link" href="/Participant/MyEnrolments">My Enrolments</a><a class="nav-link" href="/Participant/MyResults">My Results</a>}@if(Context.Session.GetString("Role")!=null){<a class="nav-link" href="/Profile">Profile</a><a class="nav-link" href="/Account/Logout">Logout</a>}else{<a class="nav-link" href="/Account/Login">Login</a><a class="nav-link" href="/Account/Register">Register</a>}</div></div></nav><main class="container py-5">@if(TempData["Message"]!=null){<div class="alert alert-success">@TempData["Message"]</div>}@RenderBody()</main><footer class="text-center py-4">RACEDAY · EVERY FINISH LINE STARTS SOMEWHERE</footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
